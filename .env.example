# Copy this file to .env and change the values. .env is never committed.

# Set DEBUG=1 on your own computer. Never on a server.
DEBUG=1

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Comma separated. localhost is allowed by default.
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed for the admin and forms on a real https domain.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# SQLite is used when this is empty. For PostgreSQL (Neon, Render, local):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# True shows a "top up" button on accounts and enables `manage.py seed_demo`.
DEMO_MODE=True
